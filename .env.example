# Copy to .env, fill in real values, then also add every one of these to:
#   - Trigger.dev dashboard → this project → Environment Variables (dev AND prod)
#   - Netlify dashboard → Site settings → Environment variables
# Never commit .env.

# Trigger.dev — from mcp__trigger__initialize_project / cloud.trigger.dev → API Keys
TRIGGER_SECRET_KEY=

# Sweep&Go — dashboard → Settings → Open API → Generate API token
SWEEPANDGO_API_TOKEN=

# GoHighLevel — Settings → Private Integrations (needs contacts + conversations/message.write scopes)
GHL_PRIVATE_INTEGRATION_TOKEN=
# Settings → Business Info
GHL_LOCATION_ID=
# Your (the owner's) cell phone number, e.g. +16783279646 — chat + signup alerts get texted here
GHL_OWNER_PHONE=
# Any random string you make up — set the same value as the "secret" query param
# on the webhook URL you configure in the GHL Workflow (see SETUP.md)
GHL_WEBHOOK_SHARED_SECRET=
